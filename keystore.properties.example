# Copy this file to keystore.properties (same folder as settings.gradle.kts) and fill in YOUR values.
# keystore.properties and the keystore file must NOT be shared or uploaded to public places.
storeFile=app/zombie.keystore
storePassword=PONER_CONTRASENA_AQUI
keyAlias=zombie
keyPassword=PONER_CONTRASENA_AQUI
# To create a new keystore (only if you do not have the original one):
#   keytool -genkeypair -keystore app/zombie.keystore -storetype PKCS12 -alias zombie -keyalg RSA -keysize 2048 -validity 36500 -dname "CN=Zombie Music Library, O=PVM, C=AR"
